[Unit]
Description=Create the AIBox MySQL database and local account
Requires=aibox-mysql-install.service mysql.service
After=aibox-mysql-install.service mysql.service

[Service]
Environment=LD_LIBRARY_PATH=/usr/local/mysql/private-lib
Type=oneshot
ExecStart=/usr/libexec/aibox-mysql-bootstrap
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
