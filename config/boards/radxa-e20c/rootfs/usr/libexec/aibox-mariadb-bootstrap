#!/bin/sh
set -eu

fail() { echo "AIBox MariaDB bootstrap: $*" >&2; exit 1; }
MARIADB_CLIENT="${AIBOX_MARIADB_CLIENT:-mariadb}"
MARIADB_ADMIN="${AIBOX_MARIADB_ADMIN:-mariadb-admin}"
secure_dir="${AIBOX_MARIADB_SECURE_DIR:-/userdata/aibox/secure}"
command -v "$MARIADB_CLIENT" >/dev/null 2>&1 || fail 'mariadb client is missing'
command -v "$MARIADB_ADMIN" >/dev/null 2>&1 || fail 'mariadb-admin is missing'

runtime_env="$secure_dir/mariadb-runtime.env"
mkdir -p "$secure_dir"
chmod 0700 "$secure_dir"
umask 077

if [ -f "$runtime_env" ]; then
    # This file is generated below and contains only shell-safe hex values.
    . "$runtime_env"
fi

MYSQL_APP_DATABASE="${MYSQL_APP_DATABASE:-aibox}"
MYSQL_APP_USER="${MYSQL_APP_USER:-aibox}"
MYSQL_APP_PASSWORD="${MYSQL_APP_PASSWORD:-}"
case "$MYSQL_APP_DATABASE:$MYSQL_APP_USER" in
    aibox:aibox) ;;
    *) fail 'unexpected application database identity' ;;
esac
case "$MYSQL_APP_PASSWORD" in
    ''|*[!0-9A-Fa-f]*) fail 'application password must be hexadecimal' ;;
esac

if [ -z "$MYSQL_APP_PASSWORD" ]; then
    MYSQL_APP_PASSWORD="$(od -An -N32 -tx1 /dev/urandom | tr -d ' \n')"
    [ "${#MYSQL_APP_PASSWORD}" = 64 ] || fail 'unable to generate application password'
    tmp_env="${runtime_env}.tmp.$$"
    {
        printf 'MYSQL_APP_DATABASE=%s\n' "$MYSQL_APP_DATABASE"
        printf 'MYSQL_APP_USER=%s\n' "$MYSQL_APP_USER"
        printf 'MYSQL_APP_PASSWORD=%s\n' "$MYSQL_APP_PASSWORD"
    } > "$tmp_env"
    chmod 0600 "$tmp_env"
    mv -f "$tmp_env" "$runtime_env"
fi

i=0
until "$MARIADB_CLIENT" --protocol=socket -uroot -e 'SELECT 1' >/dev/null 2>&1; do
    i=$((i + 1))
    [ "$i" -le 60 ] || fail 'MariaDB did not become ready'
    sleep 1
done

"$MARIADB_CLIENT" --protocol=socket -uroot <<SQL
CREATE DATABASE IF NOT EXISTS \`aibox\` CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci;
CREATE USER IF NOT EXISTS 'aibox'@'localhost' IDENTIFIED BY '${MYSQL_APP_PASSWORD}';
ALTER USER 'aibox'@'localhost' IDENTIFIED BY '${MYSQL_APP_PASSWORD}';
CREATE USER IF NOT EXISTS 'aibox'@'127.0.0.1' IDENTIFIED BY '${MYSQL_APP_PASSWORD}';
ALTER USER 'aibox'@'127.0.0.1' IDENTIFIED BY '${MYSQL_APP_PASSWORD}';
GRANT ALL PRIVILEGES ON \`aibox\`.* TO 'aibox'@'localhost';
GRANT ALL PRIVILEGES ON \`aibox\`.* TO 'aibox'@'127.0.0.1';
FLUSH PRIVILEGES;
SQL

"$MARIADB_ADMIN" --protocol=socket -uroot ping >/dev/null
echo 'AIBox MariaDB bootstrap: local database and account are ready.'
